msgstr "撤销"

#: tarot_strings.lua:250
msgid "Hide"
msgstr "盖回"

#: tarot_strings.lua:251
msgid "Tap another location to move"
msgstr "轻触另一个位置进行移动"

#: tarot_strings.lua:252
msgid "click on the card"
msgstr "点击牌面"

#: tarot_strings.lua:253
msgid "Exit"
msgstr "退出"

#: tarot_strings.lua:254
