msgstr "O Mundo"

#: tarot_cards.lua:199
msgid "Completion, fulfillment, integration, success"
msgstr "Completude, realização, integração, sucesso"

#: tarot_cards.lua:200
msgid "Saturn"
msgstr "Saturno"

#: tarot_cards.lua:201
