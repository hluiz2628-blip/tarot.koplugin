msgstr "Amor, escolha, harmonia, parceria"

#: tarot_cards.lua:65
msgid "Gemini"
msgstr "Gêmeos"

#: tarot_cards.lua:66
msgid "Imminent decision"
msgstr "Decisão iminente"

#: tarot_cards.lua:67
msgid "Love. Choice. Harmony in relationships. The heart knows the way."
msgstr "Amor. Escolha. Harmonia nos relacionamentos. O coração sabe o caminho."

#: tarot_cards.lua:68
msgid "Conflict. Imbalance. Difficult decision. Avoid impulsive choices in love."
msgstr "Conflito. Desequilíbrio. Decisão difícil. Evite escolhas impulsivas no amor."

#: tarot_cards.lua:72
