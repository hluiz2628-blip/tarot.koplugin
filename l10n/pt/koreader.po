#: tarot_cards.lua:182
msgid "Sun"
msgstr "Sol"

#: tarot_cards.lua:183
msgid "19 days, diurnal"
msgstr "19 dias, diurno"

#: tarot_cards.lua:184
msgid "Joy. Success. Vitality. Everything is illuminated. Happiness overflows."
msgstr "Alegria. Sucesso. Vitalidade. Tudo está iluminado. A felicidade transborda."

#: tarot_cards.lua:185
msgid "Temporary sadness. Delay. Lack of enthusiasm. The sun always shines again."
msgstr "Tristeza temporária. Atraso. Falta de entusiasmo. O sol sempre volta a brilhar."

