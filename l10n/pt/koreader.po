msgstr "Sacrifício, suspensão, nova visão, entrega"

#: tarot_cards.lua:119
msgid "Neptune"
msgstr "Netuno"

#: tarot_cards.lua:120
msgid "Indeterminate, pause"
msgstr "Indeterminado, pausa"

