msgstr "Sacrifício. Nova perspectiva. Deixe ir, confie. Às vezes parar é avançar."

#: tarot_cards.lua:122
msgid "Stagnation. Procrastination. Resist change. The pause has become paralysis."
msgstr "Estagnação. Adiamento. Resista à mudança. A pausa se tornou paralisia."

#: tarot_cards.lua:126
msgid "Death"
msgstr "A Morte"

#: tarot_cards.lua:127
