#: tarot_cards.lua:171 tarot_cards.lua:924
msgid "The Moon"
msgstr "A Lua"

#: tarot_cards.lua:172
msgid "Illusion, intuition, fear, subconscious"
msgstr "Ilusão, intuição, medo, subconsciente"

#: tarot_cards.lua:173
msgid "Pisces"
msgstr "Peixes"

#: tarot_cards.lua:174
