msgstr "Áries"

#: tarot_cards.lua:48
msgid "1 year, soon"
msgstr "1 ano, logo"

#: tarot_cards.lua:49
msgid "Authority. Structure. Take control. Firm leadership brings stability."
msgstr "Autoridade. Estrutura. Assuma o controle. Liderança firme traz estabilidade."

#: tarot_cards.lua:50
msgid "Tyranny. Rigidity. Lack of discipline. Excess control suffocates."
msgstr "Tirania. Rigidez. Falta de disciplina. O excesso de controle sufoca."

#: tarot_cards.lua:54
msgid "The Hierophant"
msgstr "O Hierofante"

#: tarot_cards.lua:55
