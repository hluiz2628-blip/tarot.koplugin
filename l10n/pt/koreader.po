msgstr "Touro"

#: tarot_cards.lua:57
msgid "5 weeks, slow but steady"
msgstr "5 semanas, lento mas constante"

#: tarot_cards.lua:58
msgid "Tradition. Wisdom. Seek guidance. Masters appear when the student is ready."
msgstr ""
"Tradição. Sabedoria. Busque orientação. Os mestres aparecem quando o discípulo"
