msgstr "Resistência à mudança. Estagnação. Medo do fim. Solte o que já não serve mais."

#: tarot_cards.lua:135
msgid "Temperance"
msgstr "A Temperança"

#: tarot_cards.lua:136
msgid "Patience, balance, moderation, harmony"
msgstr "Paciência, equilíbrio, moderação, harmonia"

#: tarot_cards.lua:137
